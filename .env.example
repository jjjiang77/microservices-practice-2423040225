# 复制为 .env 后按需修改：cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，不会提交到仓库

# --- MySQL 容器初始化参数（首次启动空数据卷时生效）---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=shangxiaotao
MYSQL_USER=shangxiaotao
MYSQL_PASSWORD=change-me-app

# --- 应用映射到宿主机的端口 ---
APP_PORT=8080

# Week07: 本地填写真实值；不要提交 .env
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-initialized-admin-password
NACOS_AUTH_TOKEN=replace-with-base64-of-at-least-32-random-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-random-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-random-identity-value
