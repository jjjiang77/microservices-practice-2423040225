# 复制为 .env 后按需修改：cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，不会提交到仓库

# --- MySQL 管理员与服务账号配置 ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# 三个独立账号可各自设置密码。未设置时沿用 MYSQL_PASSWORD。
# USER_DB_PASSWORD=
# PRODUCT_DB_PASSWORD=
# PURCHASE_DB_PASSWORD=
# 只有旧版数据库使用了自定义库名，迁移时才需要填写。
# MYSQL_DATABASE=shangxiaotao

# --- 应用映射到宿主机的端口 ---
APP_PORT=8080

# Week07: 本地填写真实值；不要提交 .env
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-initialized-admin-password
NACOS_AUTH_TOKEN=replace-with-base64-of-at-least-32-random-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-random-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-random-identity-value

# --- Week09: JWT 与网关内部密钥 ---
# 使用随机值，例如: openssl rand -base64 32
# 不要提交真实密钥；gateway-service 与 user-service 必须使用同一个 JWT_SECRET
JWT_SECRET=replace-with-at-least-32-random-characters
# 网关转发给下游的内部密钥，下游据此拒绝绕过网关的直连请求
GATEWAY_INTERNAL_SECRET=replace-with-random-internal-secret
# Token 有效期（秒）
JWT_TTL_SECONDS=3600
